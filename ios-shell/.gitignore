# The shell's own dependencies — reinstalled with `npm install`.
node_modules/

# www/ is GENERATED by tools/build-www.mjs — a copy of the game, rebuilt on
# every `npm run sync`. Never commit it; the sources it copies are the truth.
www/

# Xcode scratch. NOTE: ios/ itself IS committed (once the Mac has generated
# it with `npx cap add ios`) — see README.md. Only the noise is ignored.
.DS_Store
DerivedData/
**/xcuserdata/
*.xcuserstate
